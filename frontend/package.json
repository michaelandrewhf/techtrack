{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format:check": "prettier --write src/components/Tabs.test.tsx src/components/Tabs.tsx src/components/Toast.tsx src/features/customers/detail/CustomerDetailPage.tsx src/features/equipment/detail/EquipmentDetailPage.tsx && git diff -- src/components/Tabs.test.tsx src/components/Tabs.tsx src/components/Toast.tsx src/features/customers/detail/CustomerDetailPage.tsx src/features/equipment/detail/EquipmentDetailPage.tsx",
    "test": "vitest run",
    "generate:api-types": "openapi-typescript ${VITE_API_SCHEMA_URL:-http://localhost:8000/api/schema/} -o src/api/schema.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
